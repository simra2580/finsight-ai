{
  "name": "finsight-ai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FinSight AI - AI Payment Intelligence & Control Layer backend MVP",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
