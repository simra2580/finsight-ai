NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/finsight_ai
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
MAX_UPLOAD_MB=5

# AI provider: bedrock | mock
AI_PROVIDER=mock
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# S3 is optional. If disabled/unconfigured, invoice uploads use local storage.
S3_ENABLED=false
S3_BUCKET=finsight-ai-invoices
S3_PREFIX=invoices
LOCAL_UPLOAD_DIR=uploads

# Optional testnet adapter; MVP default is disabled.
TESTNET_ENABLED=false
TESTNET_NETWORK=demo-testnet
